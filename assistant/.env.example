# Copy to .env and fill in. Never put this file in your vault.
DISCORD_TOKEN=paste-bot-token-here
OWNER_ID=123456789012345678
VAULT_PATH=~/Documents/ObsidianVault
DAILY_DIR=Agent/daily
CHAT_CHANNEL=chat
QUICK_CHANNEL=quick
# Models Haiku may hand hard messages to: "sonnet" or "sonnet,opus"
ESCALATE_TO=sonnet

# Heartbeat (the Assistant messages you on its own). Leave a pair empty to turn that source off.
BRIEF_TIME=07:00
QUIET_HOURS=22-07
# iCloud: your Apple ID email + an app-specific password from appleid.apple.com
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# Gmail: your address + an app password from myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# A second Gmail account (add _3 etc. for more)
GMAIL_USER_2=
GMAIL_APP_PASSWORD_2=
